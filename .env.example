# ====================================================================
# BroHood E-Commerce Environment Variables Template
# ====================================================================

# Supabase (Database, Auth & Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# Media CDN (Cloudinary / ImageKit URL prefix)
NEXT_PUBLIC_CDN_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload

# Store Configuration
NEXT_PUBLIC_STORE_NAME=BroHood
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=1499
